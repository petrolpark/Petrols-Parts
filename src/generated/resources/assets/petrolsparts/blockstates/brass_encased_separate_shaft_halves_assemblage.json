      "apply": {
        "model": "petrolsparts:block/assemblage/encased/brass/core",
        "x": 90,
        "y": 90
      },
      "when": {
        "axis": "x"
      }
    },
    {
      "apply": {
        "model": "petrolsparts:block/assemblage/encased/brass/middle_open",
        "x": 90,
        "y": 90
      },
      "when": {
        "axis": "x",
        "middle_gear": "small|large|small_coaxial|large_coaxial"
      }
    },
    {
      "apply": {
        "model": "petrolsparts:block/assemblage/encased/brass/top_open",
        "x": 90,
        "y": 90
      },
      "when": {
        "AND": [
          {
            "axis": "x"
          },
          {
            "OR": [
              {
                "top_gear": "small_coaxial|large_coaxial",
                "top_shaft_half": "true"
              },
              {
                "top_gear": "small|large"
              }
            ]
          }
        ]
      }
    },
    {
      "apply": {
        "model": "petrolsparts:block/assemblage/encased/brass/bottom_open",
