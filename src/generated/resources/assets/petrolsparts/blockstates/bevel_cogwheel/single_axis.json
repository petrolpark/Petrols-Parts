{
  "multipart": [
    {
      "apply": {
        "model": "create:block/shaft",
        "x": 90,
        "y": 90
      },
      "when": {
        "type": "top_shaft|bottom_shaft|both",
        "axis": "x"
      }
    },
    {
      "apply": {
        "model": "petrolsparts:block/bevel_cogwheel/four_teeth",
        "x": 90,
        "y": 90
      },
      "when": {
        "type": "bottom|bottom_shaft|both",
        "axis": "x"
      }
    },
    {
      "apply": {
        "model": "petrolsparts:block/bevel_cogwheel/cog_cap",
        "x": 90,
        "y": 90
      },
      "when": {
        "type": "bottom_shaft|both",
        "axis": "x"
      }
    },
    {
      "apply": {
        "model": "petrolsparts:block/bevel_cogwheel/four_teeth",
        "x": 270,
        "y": 90
      },
      "when": {
        "type": "top|top_shaft|both",
        "axis": "x"
      }
    },
    {
      "apply": {
        "model": "petrolsparts:block/bevel_cogwheel/cog_cap",
        "x": 270,
        "y": 90
      },
      "when": {
        "type": "bottom_shaft|both",
        "axis": "x"
      }
    },
    {
      "apply": {
        "model": "create:block/shaft"
      },
      "when": {
        "type": "top_shaft|bottom_shaft|both",
        "axis": "y"
      }
    },
    {
      "apply": {
        "model": "petrolsparts:block/bevel_cogwheel/four_teeth"
      },
      "when": {
        "type": "bottom|bottom_shaft|both",
        "axis": "y"
      }
    },
    {
      "apply": {
        "model": "petrolsparts:block/bevel_cogwheel/cog_cap"
      },
      "when": {
        "type": "bottom_shaft|both",
        "axis": "y"
      }
    },
    {
      "apply": {
        "model": "petrolsparts:block/bevel_cogwheel/four_teeth",
        "x": 180
      },
      "when": {
        "type": "top|top_shaft|both",
        "axis": "y"
      }
    },
    {
      "apply": {
        "model": "petrolsparts:block/bevel_cogwheel/cog_cap",
        "x": 180
      },
      "when": {
        "type": "bottom_shaft|both",
        "axis": "y"
      }
    },
    {
      "apply": {
        "model": "create:block/shaft",
        "x": 90,
        "y": 180
      },
      "when": {
        "type": "top_shaft|bottom_shaft|both",
        "axis": "z"
      }
    },
    {
      "apply": {
        "model": "petrolsparts:block/bevel_cogwheel/four_teeth",
        "x": 90,
        "y": 180
      },
      "when": {
        "type": "bottom|bottom_shaft|both",
        "axis": "z"
      }
    },
    {
      "apply": {
        "model": "petrolsparts:block/bevel_cogwheel/cog_cap",
        "x": 90,
        "y": 180
      },
      "when": {
        "type": "bottom_shaft|both",
        "axis": "z"
      }
    },
    {
      "apply": {
        "model": "petrolsparts:block/bevel_cogwheel/four_teeth",
        "x": 270,
        "y": 180
      },
      "when": {
        "type": "top|top_shaft|both",
        "axis": "z"
