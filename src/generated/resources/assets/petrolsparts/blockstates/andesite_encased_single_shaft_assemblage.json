      "apply": {
        "model": "petrolsparts:block/assemblage/encased/andesite/middle_closed",
        "x": 90,
        "y": 180
      },
      "when": {
        "axis": "z",
        "middle_cog": "none"
      }
    },
    {
      "apply": {
        "model": "petrolsparts:block/assemblage/encased/andesite/top_closed",
        "x": 90,
        "y": 180
      },
      "when": {
        "axis": "z",
        "top_cog": "none"
      }
    },
    {
      "apply": {
        "model": "petrolsparts:block/assemblage/encased/andesite/bottom_closed",
        "x": 90,
        "y": 180
      },
      "when": {
        "axis": "z",
        "bottom_cog": "none"
      }
    }
  ]
