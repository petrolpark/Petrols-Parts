{
  "multipart": [
    {
      "apply": {
        "model": "petrolsparts:block/assemblage/encased/andesite/core",
        "x": 90,
        "y": 90
      },
      "when": {
        "axis": "x"
      }
    },
    {
      "apply": {
        "model": "petrolsparts:block/assemblage/encased/andesite/middle_open",
        "x": 90,
        "y": 90
      },
      "when": {
        "axis": "x",
        "middle_cog": "small|large|small_coaxial|large_coaxial"
      }
    },
    {
      "apply": {
        "model": "petrolsparts:block/assemblage/encased/andesite/top_open",
        "x": 90,
        "y": 90
      },
      "when": {
        "axis": "x",
        "top_cog": "small|large|small_coaxial|large_coaxial"
      }
    },
    {
      "apply": {
        "model": "petrolsparts:block/assemblage/encased/andesite/bottom_open",
        "x": 90,
        "y": 90
      },
      "when": {
        "axis": "x",
        "bottom_cog": "small|large|small_coaxial|large_coaxial"
      }
    },
    {
      "apply": {
        "model": "petrolsparts:block/assemblage/encased/andesite/middle_closed",
        "x": 90,
        "y": 90
      },
      "when": {
        "axis": "x",
        "middle_cog": "none"
      }
    },
    {
      "apply": {
        "model": "petrolsparts:block/assemblage/encased/andesite/top_closed",
        "x": 90,
        "y": 90
      },
      "when": {
        "axis": "x",
        "top_cog": "none"
      }
    },
    {
      "apply": {
        "model": "petrolsparts:block/assemblage/encased/andesite/bottom_closed",
        "x": 90,
        "y": 90
      },
      "when": {
        "axis": "x",
        "bottom_cog": "none"
      }
    },
    {
      "apply": {
        "model": "petrolsparts:block/assemblage/encased/andesite/core"
      },
      "when": {
        "axis": "y"
      }
    },
    {
      "apply": {
        "model": "petrolsparts:block/assemblage/encased/andesite/middle_open"
      },
      "when": {
        "axis": "y",
        "middle_cog": "small|large|small_coaxial|large_coaxial"
      }
    },
    {
      "apply": {
        "model": "petrolsparts:block/assemblage/encased/andesite/top_open"
      },
      "when": {
        "axis": "y",
        "top_cog": "small|large|small_coaxial|large_coaxial"
      }
