        "model": "petrolsparts:block/assemblage/encased/andesite/bottom_open"
      },
      "when": {
        "axis": "y",
        "bottom_cog": "small|large|small_coaxial|large_coaxial"
      }
    },
    {
      "apply": {
        "model": "petrolsparts:block/assemblage/encased/andesite/middle_closed"
      },
      "when": {
        "axis": "y",
        "middle_cog": "none"
      }
    },
    {
      "apply": {
        "model": "petrolsparts:block/assemblage/encased/andesite/top_closed"
      },
      "when": {
        "axis": "y",
        "top_cog": "none"
